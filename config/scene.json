  "animations": {
    "glass_transition": "transition: backdrop-filter 0.3s ease, opacity 0.3s ease, background-color 0.3s ease",
    "fade_in_glass": "animation: fadeInGlass 0.5s ease-out forwards",
    "hover_glass": "transition: backdrop-filter 0.2s ease, transform 0.2s ease",
    "focus_glass": "transition: backdrop-filter 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease",
    "gradient_animation": {
      "name": "gradient-animation",
      "duration": "30s",
      "timing": "ease",
      "iteration": "infinite",
      "keyframes": {
        "0%": "background-position: 0% 50%",
        "50%": "background-position: 100% 50%",
        "100%": "background-position: 0% 50%"
      }
    },
    "float": {
      "name": "float",
      "duration": "20s",
      "timing": "ease-in-out",
      "iteration": "infinite",
      "keyframes": {
        "0%": "transform: translate(0, 0) scale(1)",
        "33%": "transform: translate(30px, -30px) scale(1.1)",
        "66%": "transform: translate(-20px, 20px) scale(0.9)",
        "100%": "transform: translate(0, 0) scale(1)"
      }
    },
    "float_delayed": {
      "name": "float-delayed",
      "duration": "25s",
      "timing": "ease-in-out",
      "iteration": "infinite",
      "keyframes": {
        "0%": "transform: translate(0, 0) scale(1)",
        "33%": "transform: translate(-30px, 30px) scale(1.05)",
        "66%": "transform: translate(20px, -20px) scale(0.95)",
        "100%": "transform: translate(0, 0) scale(1)"
      }
    },
    "fadeIn": {
      "from": "opacity: 0",
      "to": "opacity: 1"
    },
    "slideUp": {
      "from": "transform: translateY(20px); opacity: 0",
      "to": "transform: translateY(0); opacity: 1"
    },
    "gradient_text": {
      "name": "gradient-shift",
      "duration": "3s",
      "timing": "ease",
      "iteration": "infinite",
      "keyframes": {
        "0%": "background-position: 0% center",
        "50%": "background-position: 100% center",
        "100%": "background-position: 0% center"
      }
    }
  },
  "opacity_scale": {
    "glass_light": 0.15,
    "glass_medium": 0.25,
